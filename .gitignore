.DS_Store
.vscode/
node_modules/
**/node_modules/
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
.matplotlib-cache/
exiftool-*_*/

# Local machine tool paths and credentials. Keep templates tracked, but keep
# per-machine configuration out of Git.
config/*.local.json
config/*.local.toml
config/*.local.yaml
config/*.local.yml

# Raw data, downloaded source rasters, and local GIS projects
data/raw/
data/base/
data/luhk/
data/qgis/
data/local_external/
data/TDOP_TIFF_*/
data/True_Digital_Orthophoto_TDOP_GEOPACKAGE/
data/*Raster*GEOTIFF*.zip
data/*.zip

# Intermediate and generated data
data/interim/
data/processed/**/*.tif
data/processed/**/*.tiff
data/processed/**/*.vrt
data/processed/**/*.aux.xml
data/processed/**/*.ovr
data/processed/**/*.tmp
data/processed/**/*.temp
data/processed/part_d/temperature_matrices/**/*.raw

# Generated by scripts from the source ZIP.
data/LUHK2024_extracted/

# Generated outputs and previews. Keep selected historical/reporting artifacts
# tracked explicitly if they are already part of a progress record.
outputs/**/*.tif
outputs/**/*.tiff
outputs/**/*.vrt
outputs/**/*.aux.xml
outputs/**/*.ovr
outputs/**/*.tmp
outputs/**/*.temp
outputs/**/*preview*.png
outputs/**/*overlay*.png
outputs/qgis_exports/
outputs/georef/

# Large image/video files
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.mp4
*.mov
*.avi
*.mkv

# Keep small project metadata and documentation under version control.
!data/LUHK2024_SC.csv
!data/metadata/
!data/metadata/*.csv
!data/processed/
!data/processed/**/*.csv
!docs/
!docs/**
!scripts/
!scripts/**
scripts/**/node_modules/
scripts/**/__pycache__/
scripts/**/*.py[cod]
!outputs/
!outputs/reports/
!outputs/reports/*.txt
!outputs/geodata/
!outputs/geodata/*.geojson
!outputs/archive/
!outputs/archive/**

# Local Part D temperature payloads are reproducible from raw DJI files plus
# the external SDK. Keep compact summaries tracked by explicit staging only.
data/processed/part_d/temperature_matrices/*.csv
data/processed/part_d/temperature_matrices/*.npy
data/processed/part_d/temperature_matrices/*_temperature_metadata.json

# Large reproducible Part E pixel payloads remain local. Formal code,
# configuration, compact tables, QA, reports, figures, and
# a suitably sized main workbook are explicitly unignored below.
data/processed/part_e/**/*.parquet
data/processed/part_e/samples/*.csv
data/processed/part_e/excel_source/*.csv
outputs/part_e/excel/pixel_workbooks/
outputs/part_e/workbook_previews/
outputs/part_e/excel/*.inspect.ndjson
outputs/part_e/qa/*.log
outputs/part_e/**/*.lock
outputs/part_e/**/~$*.xlsx

# Version 0.1 runtime state and canonical per-image payloads. These are
# reproducible/local artifacts, not source files.
data/processed/images/
data/metadata/canonical_result_index.json
outputs/runs/

!outputs/part_e/
!outputs/part_e/tables/
!outputs/part_e/tables/*.csv
!outputs/part_e/qa/
!outputs/part_e/qa/*.csv
!outputs/part_e/qa/*.md
!outputs/part_e/summaries/
!outputs/part_e/summaries/*.md
!outputs/part_e/figures/
!outputs/part_e/figures/excel/
!outputs/part_e/figures/excel/*.png
!outputs/part_e/figures/excel/*.pdf
!outputs/part_e/figures/spectrum/
!outputs/part_e/figures/spectrum/*.png
!outputs/part_e/figures/spectrum/*.pdf
!outputs/part_e/figures/spectrum/*.md
!outputs/part_e/figures/spatial_maps/
!outputs/part_e/figures/spatial_maps/*.png
!outputs/part_e/figures/spatial_maps/*.pdf
!outputs/part_e/excel/
!outputs/part_e/excel/part_e_pixel_statistical_analysis.xlsx

# Version 0.1 combined Part E outputs are regenerated from canonical images.
data/processed/part_e_v0_1/
outputs/part_e/tables/part_e_v0_1_source_summary.csv
