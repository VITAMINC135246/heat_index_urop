    "dashboard_directory": "outputs/part_e/source_dashboard",
    "formal_enabled": true,
    "formal_output_root": "outputs/part_e/schema_0_2",
    "write_full_pixel_csv": false,
    "write_per_image_excel": false,
    "pool_sources_by_default": false,
    "cross_image_weighting": "equal_image"
  }
